{#- Rendered by `mise dot apply` / `mise bootstrap` into ~/.config/iron-proxy/config.yaml.
    Edit this template (~/.config/mise/dotfiles/iron-proxy/config.yaml.tera), not the output.

    The proxy binds to this machine's Tailscale IPv4 so sandbox VMs on the tailnet can
    reach it. If Tailscale is not installed or not up yet, it falls back to loopback;
    re-run `mise dot apply` after logging in to Tailscale, then restart the agent:
      launchctl kickstart -k gui/$(id -u)/dev.mise.iron-proxy -#}
{%- set tailscale_ip = exec(command="tailscale ip -4 2>/dev/null || /Applications/Tailscale.app/Contents/MacOS/Tailscale ip -4 2>/dev/null || echo 127.0.0.1") | trim -%}
{%- set data_dir = env.HOME ~ "/.local/share/iron-proxy" -%}
# GENERATED by mise from ~/.config/mise/dotfiles/iron-proxy/config.yaml.tera - do not edit.
dns:
  listen: "{{ tailscale_ip }}:5300"
  proxy_ip: "{{ tailscale_ip }}"
  passthrough:
    - "*.tailscale.com"
    - "*.tailscale.io"
    - "*.ts.net"

proxy:
  http_listen: "{{ tailscale_ip }}:8080"
  https_listen: "{{ tailscale_ip }}:8443"
  tunnel_listen: "{{ tailscale_ip }}:3128"

tls:
  mode: mitm
  ca_cert: "{{ data_dir }}/iron-ca.crt"
  ca_key: "{{ data_dir }}/iron-ca.key"

transforms:
  - name: secrets
    config:
      secrets:
        - source:
            type: env
            var: GITHUB_TOKEN
          replace:
            proxy_value: "__secret_github_token"
            match_headers: ["Authorization"]
          rules:
            # glob covers github.com itself plus api., uploads., codeload., ...
            - host: "*.github.com"
            # raw. and objects. (LFS / release assets)
            - host: "*.githubusercontent.com"

        - source:
            type: env
            var: OPENROUTER_KEY
          replace:
            proxy_value: "__secret_openrouter_key"
            match_headers: ["Authorization"]
          rules:
            - host: "openrouter.ai"
              paths: ["/api/*"]
